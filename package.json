{
  "name": "novaunlock-desktop",
  "version": "1.0.0",
  "description": "NovaUnlock Desktop — Outil de déverrouillage iOS via USB pour Windows",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsc -w -p electron/tsconfig.json\"",
    "dev:electron": "concurrently \"vite\" \"tsc -w -p electron/tsconfig.json\" \"wait-on http://localhost:5173 && electron .\"",
    "build:frontend": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && tsc -p electron/preload/tsconfig.json",
    "build:all": "npm run build:frontend && npm run build:electron",
    "package": "npm run build:all && electron-builder",
    "package:win": "npm run build:all && electron-builder --win",
    "package:win:portable": "npm run build:all && electron-builder --win portable",
    "test": "vitest run",
    "lint": "eslint src electron --ext .ts,.tsx"
  },
  "build": {
    "appId": "com.novaunlock.desktop",
    "productName": "NovaUnlock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/novaunlock-icon.png",
      "artifactName": "NovaUnlock-Setup-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/assets/novaunlock-icon.png",
      "uninstallerIcon": "public/assets/novaunlock-icon.png",
      "installerHeaderIcon": "public/assets/novaunlock-icon.png",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NovaUnlock"
    },
    "extraResources": [
      {
        "from": "native/",
        "to": "native/",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "axios": "^1.6.7",
    "node-fetch": "^3.3.2",
    "node-hid": "^2.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "react-router-dom": "^7.18.4",
    "usb": "^3.1.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.11.0",
    "@types/node-hid": "^1.3.4",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^2.1.9",
    "wait-on": "^7.2.0"
  }
}
